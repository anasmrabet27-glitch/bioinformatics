   "source": [
    "In this notebook we opened a fasta file for the BRCA1 gene containing multiple transcript sequences, we used 'break' to process only the first sequence during testing instead of processing all the sequences, then we created a table containing the results and converted it into a Pandas DataFrame for further analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "ebf1c320-1fd7-48af-a214-36ebcdbc1468",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Desc NM_001407571.1 BRCA1 [organism=Homo sapiens] [GeneID=672] [transcript=6]\n"
     ]
    }
   ],
   "source": [
    "from Bio import SeqIO\n",
    "for record in SeqIO.parse(r\"C:.....\Downloads\\rna.fna\",\"fasta\"):\n",
    "    print(\"Desc\", record.description)\n",
    "    break\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "b804e40f-8f28-429c-9b66-450c2f6eaf48",
   "metadata": {},
   "outputs": [],
   "source": [
    "from Bio import SeqIO\n",
    "\n",
    "filename = r\"C:......\Downloads\\rna.fna\"\n",
    "\n",
    "results = []\n",
    "\n",
    "for record in SeqIO.parse(filename, \"fasta\"):\n",
    "    seq = record.seq\n",
    "\n",
    "    results.append({\n",
    "        \"ID\": record.id,\n",
    "        \"Description\": record.description,\n",
    "        \"Length\": len(seq),\n",
    "        \"A\": seq.count(\"A\"),\n",
    "        \"T\": seq.count(\"T\"),\n",
    "        \"G\": seq.count(\"G\"),\n",
    "        \"C\": seq.count(\"C\"),\n",
    "    })"
   ]
  },
